<div class="toast" id="toast"></div>

<script>
// ══ CONSTANTS ════════════════════════════════════════════════
const DEP_FEE      = 0.01;   // 1% deposit fee
const WD_FEE       = 0.03;   // 3% withdrawal fee
const TARGET_PCT   = 3.0;    // 300% of original = target earnings
const BD_MONTH     = 21;     // business days per month
const BD_WEEK      = 5;      // business days per week

// Packages: Inicial 0.60% | Bronce 0.65% | Plata 0.70% | Oro 0.75% (Mon-Fri)
const PKGS = [
  { n:1, name:'Inicial', min:30,    max:999,      rate:0.006,  cls:'b1', col:'#8B9EFF' },
  { n:2, name:'Bronce',  min:1000,  max:9999,     rate:0.0065, cls:'b2', col:'#9B80FF' },
  { n:3, name:'Plata',   min:10000, max:29999,    rate:0.0070, cls:'b3', col:'#D4AF37' },
  { n:4, name:'Oro',     min:30000, max:Infinity,  rate:0.0075, cls:'b4', col:'#FF9060' },
];

const PRESETS = [100, 500, 2000, 50000];
let CUR  = null;
let VIEW = 'm';

// ══ HELPERS ══════════════════════════════════════════════════
function getPkg(amt){ return PKGS.find(p => amt >= p.min && amt <= p.max) || null; }

function fm(n, d=2){
  if(n===null||isNaN(n)) return '$0.00';
  const abs=Math.abs(n);
  return (n<0?'-':'')+'$'+abs.toLocaleString('en-US',{minimumFractionDigits:d,maximumFractionDigits:d});
}

function fd(d){ return d.toLocaleDateString('es-MX',{year:'numeric',month:'long',day:'numeric'}); }

function addBD(date, days){
  let d=new Date(date), a=0;
  while(a<days){ d.setDate(d.getDate()+1); const dw=d.getDay(); if(dw&&dw!==6) a++; }
  return d;
}

function countBD(start, end){
  let c=0, d=new Date(start); d.setHours(0,0,0,0);
  const e=new Date(end); e.setHours(0,0,0,0);
  while(d<e){ d.setDate(d.getDate()+1); const dw=d.getDay(); if(dw&&dw!==6) c++; }
  return c;
}

// ══ CORE CALCULATION ══════════════════════════════════════════
// HOW THE NFT WORKS:
//   • Balance starts at $0 on Day 1 — you do NOT start with your capital in hand.
//   • Each business day (Mon–Fri) earns: net × daily_rate  (net = amount × 0.99)
//   • CAPITAL RECOVERY: when accumulated earnings ≥ original amount (~6–9 months)
//   • NFT COMPLETES: when accumulated earnings ≥ 300% of original (~19–24 months)
//   • Total payout = accumulated earnings ≈ 3× original investment
function calc(amount){
  const pkg = getPkg(amount);
  if(!pkg) return null;

  const net        = amount * (1 - DEP_FEE);         // base used for rate calculation
  const daily      = net * pkg.rate;                  // daily earnings (Mon–Fri)
  const targetEarn = amount * TARGET_PCT;              // target = 300% of ORIGINAL
  const totalDays  = Math.ceil(targetEarn / daily);   // business days to reach 300%
  const totalEarn  = daily * totalDays;                // total earnings at completion ≈ 3× original
  const months     = (totalDays / BD_MONTH);
  const monthsStr  = `~${Math.floor(months)}–${Math.ceil(months)} meses`;

  // CAPITAL RECOVERY: days until accumulated earnings = original investment
  const recoveryDays = Math.ceil(amount / daily);
  const recM         = recoveryDays / BD_MONTH;
  const recoveryStr  = `~${Math.floor(recM)}–${Math.ceil(recM)} meses`;
  const recoveryDate = addBD(new Date(), recoveryDays);

  return {
    amount, pkg, net,
    fee:          amount * DEP_FEE,
    daily,
    weekly:       daily * BD_WEEK,
    monthly:      daily * BD_MONTH,
    totalEarn,
    totalDays,    monthsStr,
    recoveryDays, recoveryStr, recoveryDate,
    endDate:      addBD(new Date(), totalDays),
  };
}

// ══ ANIMATED COUNTER ═════════════════════════════════════════
function animNum(el, target, dur=700){
  const t0=performance.now();
  function step(now){
    const p=Math.min((now-t0)/dur,1);
    const ease=1-Math.pow(1-p,3);
    el.textContent='$'+(target*ease).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});
    if(p<1) requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}

// ══ LIVE PACKAGE INDICATOR ═══════════════════════════════════
document.getElementById('inv').addEventListener('input',function(){
  const amt=parseFloat(this.value);
  const el=document.getElementById('pkgind');
  if(!amt||isNaN(amt)){
    el.className='pkgind';
    el.innerHTML='<span class="pkgdot"></span><span>Ingresa un monto para detectar el paquete</span>';
    return;
  }
  if(amt<30){
    el.className='pkgind';
    el.innerHTML='<span class="pkgdot"></span><span>Monto mínimo: $30 USD</span>';
    return;
  }
  const pkg=getPkg(amt);
  if(pkg){
    const c=calc(amt);
    el.className='pkgind on';
    el.innerHTML=`<span class="pkgdot" style="background:${pkg.col}"></span>
      <strong>${pkg.name}</strong> — ${(pkg.rate*100).toFixed(2)}% diario · capital recuperado en <strong>${c.recoveryStr}</strong>`;
  }
});

// ══ MAIN CALCULATE ═══════════════════════════════════════════
function doCalc(preset){
  const amt=preset||parseFloat(document.getElementById('inv').value);
  if(!amt||isNaN(amt)||amt<30){ showToast('⚠ Ingresa mínimo $30 USD'); return; }
  const c=calc(amt); if(!c){ showToast('⚠ Monto inválido'); return; }
  CUR=c;

  if(!preset) document.getElementById('inv').value=amt;

  const ind=document.getElementById('pkgind');
  ind.className='pkgind on';
  ind.innerHTML=`<span class="pkgdot" style="background:${c.pkg.col}"></span>
    <strong>${c.pkg.name}</strong> — ${(c.pkg.rate*100).toFixed(2)}% diario · capital recuperado en <strong>${c.recoveryStr}</strong>`;

  const rows=[
    { lbl:'Paquete',             val:c.pkg.name,         sub:`${(c.pkg.rate*100).toFixed(2)}% diario · Balance inicial: $0`,  cls:'hp', raw:null },
    { lbl:'Base de Cálculo',    val:c.net,              sub:`Fee depósito: ${fm(c.fee)} · Usada para tasa diaria`,            cls:'',   raw:c.net },
    { lbl:'Ganancia Diaria',    val:c.daily,            sub:'1 día hábil (lun–vie)',                                          cls:'hl', raw:c.daily },
    { lbl:'Ganancia Semanal',   val:c.weekly,           sub:'5 días hábiles',                                                 cls:'hl', raw:c.weekly },
    { lbl:'Ganancia Mensual',   val:c.monthly,          sub:'~21 días hábiles',                                               cls:'hl', raw:c.monthly },
    { lbl:'Recuperas Capital',  val:c.recoveryStr,      sub:`${c.recoveryDays} días hábiles · ${fd(c.recoveryDate)}`,         cls:'hp', raw:null },
    { lbl:'Ganancias Totales',  val:c.totalEarn,        sub:'Al alcanzar 300% del NFT',                                       cls:'hl', raw:c.totalEarn },
    { lbl:'Días hasta 300%',    val:c.totalDays+' días hábiles', sub:c.monthsStr,                                             cls:'hp', raw:null },
    { lbl:'Fecha Estimada',     val:fd(c.endDate),      sub:'Al completar el NFT',                                            cls:'',   raw:null },
    { lbl:'Ganancia Neta',      val:fm(c.totalEarn-c.amount)+' profit', sub:`${((c.totalEarn/c.amount)*100).toFixed(1)}% retorno sobre capital`, cls:'hg', raw:null },
  ];

  document.getElementById('rgrid').innerHTML=rows.map((r,i)=>`
    <div class="ri ${r.cls}">
      <div class="rlabel">${r.lbl}</div>
      <div class="rval ${r.cls==='hp'?'p':r.cls==='hg'?'gr':r.raw===null?'w':''}" id="rv${i}">
        ${r.raw!==null ? fm(r.raw) : r.val}
      </div>
      <div class="rsub">${r.sub}</div>
    </div>`).join('');

  rows.forEach((r,i)=>{ if(r.raw!==null) animNum(document.getElementById('rv'+i),r.raw,750); });

  const res=document.getElementById('results');
  res.className='show';
  updateTable();
  setTimeout(()=>res.scrollIntoView({behavior:'smooth',block:'nearest'}),120);
}

// ══ WITHDRAWAL ═══════════════════════════════════════════════
function doWithdraw(){
  const amt=parseFloat(document.getElementById('wamt').value);
  const dval=document.getElementById('wdate').value;
  const el=document.getElementById('wres');
  if(!amt||isNaN(amt)||amt<=0){ el.className='wres'; return; }

  const fee=amt*WD_FEE, net=amt-fee;
  let earnedNote='', remBal=null;

  if(CUR&&dval){
    const wd=new Date(dval+'T12:00:00');
    const today=new Date(); today.setHours(0,0,0,0);
    const bd=Math.min(countBD(today,wd), CUR.totalDays);
    const avail=CUR.daily*bd;  // balance starts from $0 — only accumulated earnings
    const recFlag=bd>=CUR.recoveryDays?' · ✓ Capital recuperado':'';
    remBal=avail-amt;
    earnedNote=`${bd} días hábiles${recFlag} · Ganancias acumuladas: ${fm(avail)}`;
  }

  const items=[
    { lbl:'Monto Bruto',     val:amt,    col:'var(--wh)',   big:false },
    { lbl:'Comisión (3%)',   val:fee,    col:'#ff7070',     big:false, minus:true },
    { lbl:'Recibes Neto',    val:net,    col:'var(--gold)', big:true },
    ...(remBal!==null?[{ lbl:'Saldo Restante', val:remBal, col:remBal>=0?'var(--pur-l)':'#ff7070', big:false }]:[]),
  ];

  el.className='wres show';
  el.innerHTML=items.map(it=>`
    <div class="ri ${it.big?'hl':''}">
      <div class="rlabel">${it.lbl}</div>
      <div class="rval" style="color:${it.col};font-size:${it.big?'20px':'16px'}">
        ${it.minus?'−':''}${fm(Math.abs(it.val))}
      </div>
    </div>`).join('')
    +(earnedNote?`<div style="grid-column:1/-1;font-size:11px;color:var(--dim);padding:4px 2px">${earnedNote}</div>`:'');
}

// ══ PROJECTION TABLE ═════════════════════════════════════════
function setView(v){
  VIEW=v;
  document.getElementById('btnM').className='tbtn'+(v==='m'?' on':'');
  document.getElementById('btnW').className='tbtn'+(v==='w'?' on':'');
  updateTable();
}

function updateTable(){
  if(!CUR) return;
  const {net, pkg, totalDays, amount}=CUR;
  const rate=pkg.rate;
  const step=VIEW==='m'?BD_MONTH:BD_WEEK;
  const label=VIEW==='m'?'Mes':'Semana';
  const rows=[], daily=net*rate;
  let cum=0, done=0, n=1;

  while(done<totalDays){
    const d=Math.min(step, totalDays-done);
    const earn=daily*d;
    cum+=earn; done+=d;
    const pct=(done/totalDays)*100;
    const retPct=((cum/amount)*100).toFixed(1);
    const capRec=cum>=amount&&(cum-earn)<amount;  // first period earnings cross original capital
    rows.push({period:`${label} ${n}`, d, earn, cum, pct, tot:cum, retPct, capRec});
    n++;
  }

  document.getElementById('pnote').textContent=
    `${rows.length} ${VIEW==='m'?'meses':'semanas'} · ${totalDays} días hábiles hasta 300%`;

  document.getElementById('tbox').innerHTML=`<table>
    <thead><tr>
      <th>${label}</th><th>Días</th><th>Ganancia del Período</th>
      <th>Ganancias Acumuladas</th><th>% Retorno</th><th>% NFT</th><th>Total Acumulado</th>
    </tr></thead>
    <tbody>${rows.map(r=>`<tr${r.capRec?' class="cap-rec-row"':''}>
      <td>${r.period}${r.capRec?'<span class="cap-badge">✓ Capital recuperado</span>':''}</td>
      <td style="text-align:right;color:var(--dim)">${r.d}</td>
      <td class="m">${fm(r.earn)}</td>
      <td class="m${r.capRec?' cap-rec-val':''}">${fm(r.cum)}</td>
      <td class="pt">${r.retPct}%</td>
      <td class="pt">${r.pct.toFixed(1)}%
        <div class="mbar"><div class="mbarfill" style="width:${r.pct}%"></div></div>
      </td>
      <td class="tot">${fm(r.tot)}</td>
    </tr>`).join('')}</tbody>
  </table>`;
}

// ══ PRESETS ══════════════════════════════════════════════════
function buildPresets(){
  document.getElementById('pgrid').innerHTML=PRESETS.map(amt=>{
    const c=calc(amt); if(!c) return '';
    return `<div class="pcard" onclick="usePreset(${amt})" id="pc${amt}">
      <div class="pa">${fm(amt,0)}</div>
      <div class="pp">${c.pkg.name} · ${(c.pkg.rate*100).toFixed(2)}% diario</div>
      <div class="pstats">
        <div class="pstat"><span class="l">Diario</span><span class="v">${fm(c.daily)}</span></div>
        <div class="pstat"><span class="l">Mensual</span><span class="v">${fm(c.monthly)}</span></div>
        <div class="pstat"><span class="l">Total al 300%</span><span class="v">${fm(c.totalEarn)}</span></div>
        <div class="pstat"><span class="l">Recupera capital</span><span class="v">${c.recoveryStr}</span></div>
      </div>
      <div class="pdur">${c.monthsStr} · ${c.totalDays}d hábiles</div>
    </div>`;
  }).join('');
}

function usePreset(amt){
  document.querySelectorAll('.pcard').forEach(c=>c.classList.remove('active'));
  const el=document.getElementById('pc'+amt); if(el) el.classList.add('active');
  document.getElementById('inv').value=amt;
  document.getElementById('inv').dispatchEvent(new Event('input'));
  doCalc(amt);
  setTimeout(()=>document.getElementById('calc-sec').scrollIntoView({behavior:'smooth',block:'start'}),80);
}

// ══ COMPARISON TABLE ═════════════════════════════════════════
function buildComparison(){
  const mins=[30,1000,10000,30000];
  document.getElementById('ctbody').innerHTML=PKGS.map((pkg,i)=>{
    const c=calc(mins[i]); if(!c) return '';
    const maxLabel=pkg.max===Infinity?'sin límite':fm(pkg.max,0);
    const months=Math.round(c.totalDays/BD_MONTH);
    return `<tr>
      <td><span class="pkbadge ${pkg.cls}">${pkg.name}</span></td>
      <td style="color:var(--dim)">${fm(pkg.min,0)} – ${maxLabel}</td>
      <td class="pt">${(pkg.rate*100).toFixed(2)}%</td>
      <td class="m">${fm(c.monthly)}</td>
      <td class="pt">${c.recoveryStr}</td>
      <td class="pt">${c.totalDays} días</td>
      <td class="pt">~${months} meses</td>
      <td class="m">${fm(c.totalEarn)}</td>
    </tr>`;
  }).join('');
}

// ══ SHARE ════════════════════════════════════════════════════
function doShare(){
  if(!CUR){ showToast('⚠ Primero calcula una inversión'); return; }
  const c=CUR;
  const txt=
`💰 *MINTTORA – Simulación de Inversión*

📊 Monto invertido: ${fm(c.amount)}
📦 ${c.pkg.name} · ${(c.pkg.rate*100).toFixed(2)}% diario
💵 Neto invertido (tras 1% fee): ${fm(c.net)}

📈 *Rendimientos estimados:*
• Diario: ${fm(c.daily)}
• Semanal (5 días): ${fm(c.weekly)}
• Mensual (~21 días): ${fm(c.monthly)}
• Ganancias totales al 300%: ${fm(c.totalEarn)}
• Recuperas tu capital en: ${c.recoveryStr} (${c.recoveryDays} días hábiles)

⏱ Duración estimada: ${c.monthsStr} (${c.totalDays} días hábiles)
📅 Fecha estimada de cierre: ${fd(c.endDate)}

_Los rendimientos son estimados y pueden variar entre 8–15% mensual según condiciones de mercado. Esto no constituye asesoría financiera._`;

  if(navigator.clipboard){
    navigator.clipboard.writeText(txt).then(()=>showToast('✓ Copiado — pégalo en WhatsApp'));
  } else {
    const ta=document.createElement('textarea'); ta.value=txt;
    document.body.appendChild(ta); ta.select(); document.execCommand('copy');
    document.body.removeChild(ta); showToast('✓ Copiado — pégalo en WhatsApp');
  }
}

// ══ TOAST ════════════════════════════════════════════════════
let toastTimer;
function showToast(msg){
  const t=document.getElementById('toast'); t.textContent=msg; t.classList.add('show');
  clearTimeout(toastTimer); toastTimer=setTimeout(()=>t.classList.remove('show'),3200);
}

// ══ INIT ═════════════════════════════════════════════════════
(function init(){
  buildPresets();
  buildComparison();
  const now=new Date();
  const y=now.getFullYear(), m=String(now.getMonth()+1).padStart(2,'0'), d=String(now.getDate()).padStart(2,'0');
  document.getElementById('wdate').value=`${y}-${m}-${d}`;
})();
</script>
