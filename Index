<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Minttora — Calculadora de Inversión en Oro</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0A0A0F;--bg2:#0E0E18;
  --pur:#6B4EE5;--pur-l:#9B80FF;--pur-d:#4830C0;
  --gold:#D4AF37;--gold-l:#F0D060;
  --wh:#F0F0F0;--dim:rgba(240,240,240,.52);
  --cb:rgba(255,255,255,.04);--cbr:rgba(255,255,255,.08);
  --blur:blur(20px)
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{background:var(--bg);color:var(--wh);font-family:'Space Grotesk',sans-serif;line-height:1.6;overflow-x:hidden;min-height:100vh}
body::before{content:'';position:fixed;inset:0;background-image:linear-gradient(rgba(107,78,229,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(107,78,229,.03) 1px,transparent 1px);background-size:56px 56px;pointer-events:none;z-index:0}
.gp{position:fixed;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,rgba(107,78,229,.11) 0%,transparent 70%);top:-160px;right:-160px;pointer-events:none;z-index:0}
.gg{position:fixed;width:320px;height:320px;border-radius:50%;background:radial-gradient(circle,rgba(212,175,55,.07) 0%,transparent 70%);bottom:60px;left:-100px;pointer-events:none;z-index:0}

/* ── HEADER ── */
header{position:sticky;top:0;z-index:100;background:rgba(10,10,15,.92);backdrop-filter:var(--blur);border-bottom:1px solid var(--cbr)}
.hdr{max-width:1200px;margin:0 auto;padding:0 20px;height:60px;display:flex;align-items:center;justify-content:space-between;gap:16px}
.logo-wrap{display:flex;align-items:center;flex-shrink:0;text-decoration:none}
.logo-img{height:30px;width:auto;max-width:170px;object-fit:contain;object-position:left;display:block}
nav{display:flex;gap:2px;overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch}
nav::-webkit-scrollbar{display:none}
nav a{color:var(--dim);text-decoration:none;font-size:12px;font-weight:500;padding:6px 12px;border-radius:100px;white-space:nowrap;transition:all .2s}
nav a:hover{color:var(--wh);background:rgba(107,78,229,.22)}

/* ── MAIN ── */
main{position:relative;z-index:1;max-width:1200px;margin:0 auto;padding:36px 20px 80px}
section{margin-bottom:52px}

/* ── HERO ── */
.hero{text-align:center;padding:52px 0 28px}
.htag{display:inline-flex;align-items:center;gap:8px;background:rgba(212,175,55,.09);border:1px solid rgba(212,175,55,.22);border-radius:100px;padding:6px 18px;font-size:11px;font-weight:700;color:var(--gold);letter-spacing:1.5px;text-transform:uppercase;margin-bottom:18px}
.htag::before{content:'';width:6px;height:6px;background:var(--gold);border-radius:50%;animation:blink 2s infinite;flex-shrink:0}
@keyframes blink{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.35;transform:scale(.65)}}
.hero h1{font-family:'Syne',sans-serif;font-size:clamp(28px,6vw,60px);font-weight:800;line-height:1.1;margin-bottom:14px}
.hero h1 .g{color:var(--gold)}
.hero p{font-size:clamp(13px,1.8vw,16px);color:var(--dim);max-width:500px;margin:0 auto}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}
.chip{display:inline-flex;align-items:center;gap:6px;padding:5px 13px;border-radius:100px;font-size:11px;font-weight:500;background:var(--cb);border:1px solid var(--cbr);color:var(--dim)}
.chip .dot{width:5px;height:5px;border-radius:50%;flex-shrink:0}

/* ── SECTION HEADERS ── */
.sh{display:flex;align-items:center;gap:10px;margin-bottom:22px}
.sh h2{font-family:'Syne',sans-serif;font-size:clamp(17px,2.5vw,24px);font-weight:700}
.badge{background:linear-gradient(135deg,var(--pur),var(--pur-l));color:#fff;font-size:10px;font-weight:700;padding:4px 10px;border-radius:100px;letter-spacing:.5px;text-transform:uppercase;white-space:nowrap}

/* ── CARDS ── */
.card{background:var(--cb);border:1px solid var(--cbr);border-radius:20px;padding:24px;backdrop-filter:var(--blur);position:relative;overflow:hidden}
.card::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(212,175,55,.2),transparent)}

/* ── PRESETS ── */
.pgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.pcard{background:var(--cb);border:1px solid var(--cbr);border-radius:16px;padding:18px;cursor:pointer;transition:all .3s cubic-bezier(.34,1.56,.64,1)}
.pcard:hover{transform:translateY(-5px);border-color:rgba(212,175,55,.38);box-shadow:0 20px 40px rgba(0,0,0,.4),0 0 0 1px rgba(212,175,55,.1)}
.pcard.active{border-color:var(--gold);box-shadow:0 0 0 1px rgba(212,175,55,.28),0 16px 36px rgba(0,0,0,.35)}
.pa{font-family:'Syne',sans-serif;font-size:clamp(20px,2.5vw,26px);font-weight:800;color:var(--gold);margin-bottom:2px}
.pp{font-size:10px;font-weight:600;color:var(--pur-l);letter-spacing:.8px;text-transform:uppercase;margin-bottom:12px}
.pstats{display:flex;flex-direction:column;gap:5px}
.pstat{display:flex;justify-content:space-between;align-items:center;font-size:12px}
.pstat .l{color:var(--dim)}
.pstat .v{color:var(--gold);font-weight:600}
.pdur{display:inline-block;margin-top:10px;font-size:10px;font-weight:600;color:var(--pur-l);background:rgba(107,78,229,.1);border:1px solid rgba(107,78,229,.2);padding:3px 9px;border-radius:100px}

/* ── CALCULATOR ── */
.cgrid{display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:start}
.ig{display:flex;flex-direction:column;gap:6px}
.ig label{font-size:10px;font-weight:700;color:var(--dim);letter-spacing:1px;text-transform:uppercase}
.iw{position:relative}
.ipfx{position:absolute;left:14px;top:50%;transform:translateY(-50%);font-size:17px;font-weight:700;color:var(--gold);pointer-events:none;z-index:1}
input[type=number],input[type=date]{width:100%;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:12px;padding:14px 14px 14px 36px;font-family:'Space Grotesk',sans-serif;font-size:16px;font-weight:600;color:var(--wh);outline:none;transition:all .2s;-moz-appearance:textfield;-webkit-appearance:none}
input[type=date]{padding:14px;font-size:14px}
input::-webkit-outer-spin-button,input::-webkit-inner-spin-button{-webkit-appearance:none}
input:focus{border-color:var(--pur);background:rgba(107,78,229,.08);box-shadow:0 0 0 3px rgba(107,78,229,.14)}
input::placeholder{color:rgba(240,240,240,.18);font-size:14px}
.pkgind{display:flex;align-items:center;gap:8px;padding:11px 14px;border-radius:10px;background:rgba(107,78,229,.09);border:1px solid rgba(107,78,229,.18);font-size:13px;color:var(--pur-l);font-weight:500;transition:all .3s;margin-top:10px;min-height:44px}
.pkgind.on{background:rgba(212,175,55,.07);border-color:rgba(212,175,55,.22);color:var(--gold)}
.pkgdot{width:7px;height:7px;border-radius:50%;background:currentColor;flex-shrink:0}
.bcalc{width:100%;padding:15px;background:linear-gradient(135deg,var(--pur),var(--pur-l));border:none;border-radius:12px;font-family:'Syne',sans-serif;font-size:14px;font-weight:700;color:#fff;cursor:pointer;letter-spacing:1px;text-transform:uppercase;transition:all .3s cubic-bezier(.34,1.56,.64,1);position:relative;overflow:hidden;min-height:50px}
.bcalc::before{content:'';position:absolute;top:0;left:-100%;width:100%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.13),transparent);transition:left .5s}
.bcalc:hover{transform:translateY(-2px);box-shadow:0 12px 28px rgba(107,78,229,.45)}
.bcalc:hover::before{left:100%}
.bcalc:active{transform:translateY(0)}

/* ── INFO BOX ── */
.infobox{background:rgba(107,78,229,.07);border:1px solid rgba(107,78,229,.18);border-radius:12px;padding:12px 14px;font-size:12px;color:var(--dim);line-height:1.6}
.infobox strong{color:var(--pur-l)}

/* ── RESULTS ── */
#results{display:none}
#results.show{display:block;animation:fiu .4s ease}
@keyframes fiu{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
.rdiv{height:1px;background:linear-gradient(90deg,transparent,var(--cbr),transparent);margin:22px 0}
.rhdr{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;flex-wrap:wrap;gap:10px}
.rtitle{font-family:'Syne',sans-serif;font-size:16px;font-weight:700}
.bshare{display:flex;align-items:center;gap:6px;padding:9px 16px;background:rgba(37,211,102,.1);border:1px solid rgba(37,211,102,.22);border-radius:100px;font-family:'Space Grotesk',sans-serif;font-size:12px;font-weight:600;color:#25D366;cursor:pointer;transition:all .2s}
.bshare:hover{background:rgba(37,211,102,.18);transform:translateY(-1px)}

/* ── RESULT GRID (fixed 4 cols → no overflow) ── */
.rgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.ri{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);border-radius:14px;padding:14px 12px;text-align:center;overflow:hidden}
.ri.hl{background:rgba(212,175,55,.06);border-color:rgba(212,175,55,.16)}
.ri.hp{background:rgba(107,78,229,.08);border-color:rgba(107,78,229,.18)}
.ri.hg{background:rgba(37,211,102,.05);border-color:rgba(37,211,102,.15)}
.rlabel{font-size:9px;font-weight:700;color:var(--dim);letter-spacing:.9px;text-transform:uppercase;margin-bottom:8px;line-height:1.3}
.rval{font-family:'Syne',sans-serif;font-size:clamp(13px,1.55vw,18px);font-weight:800;color:var(--gold);line-height:1.2;word-break:break-word;overflow-wrap:anywhere}
.rval.p{color:var(--pur-l)}
.rval.w{color:var(--wh)}
.rval.gr{color:#4ADE80}
.rsub{font-size:9px;color:var(--dim);margin-top:5px;line-height:1.3}

/* ── WITHDRAWAL ── */
.wgrid{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.wres{margin-top:18px;display:none}
.wres.show{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px;animation:fiu .3s ease}

/* ── PROJECTION TABLE ── */
.tctrl{display:flex;gap:7px;align-items:center;margin-bottom:16px;flex-wrap:wrap}
.tbtn{padding:7px 16px;border-radius:100px;border:1px solid var(--cbr);background:transparent;color:var(--dim);font-family:'Space Grotesk',sans-serif;font-size:12px;font-weight:600;cursor:pointer;transition:all .2s;min-height:36px}
.tbtn.on{background:linear-gradient(135deg,var(--pur),var(--pur-l));border-color:transparent;color:#fff}
.tbtn:hover:not(.on){border-color:rgba(255,255,255,.2);color:var(--wh)}
.tbox{overflow:auto;max-height:400px;border-radius:14px;border:1px solid var(--cbr)}
table{width:100%;border-collapse:collapse}
thead{position:sticky;top:0;z-index:2}
thead tr{background:rgba(107,78,229,.18)}
th{padding:10px 13px;text-align:right;font-weight:700;font-size:10px;letter-spacing:.9px;text-transform:uppercase;color:var(--pur-l);white-space:nowrap;border-bottom:1px solid rgba(107,78,229,.22)}
th:first-child{text-align:left}
tbody tr{border-bottom:1px solid rgba(255,255,255,.03);transition:background .15s}
tbody tr:hover{background:rgba(255,255,255,.025)}
tbody tr:last-child{border-bottom:none}
td{padding:10px 13px;text-align:right;font-size:12px}
td:first-child{text-align:left;font-weight:600}
td.m{color:var(--gold);font-weight:600}
td.pt{color:var(--pur-l)}
td.tot{color:var(--wh);font-weight:700}
.mbar{height:3px;background:rgba(255,255,255,.07);border-radius:2px;margin-top:3px}
.mbarfill{height:100%;background:linear-gradient(90deg,var(--pur),var(--gold));border-radius:2px}
.tempty{padding:44px;text-align:center;color:var(--dim);font-size:13px}

/* ── COMPARISON ── */
.ctbox{overflow-x:auto;border-radius:16px;border:1px solid var(--cbr)}
.ctbl{min-width:700px}
.ctbl th:first-child,.ctbl td:first-child{text-align:left;min-width:110px}
.pkbadge{display:inline-flex;align-items:center;font-size:10px;font-weight:700;padding:4px 10px;border-radius:100px;white-space:nowrap}
.b1{background:rgba(100,120,255,.12);color:#8B9EFF}
.b2{background:rgba(107,78,229,.14);color:#9B80FF}
.b3{background:rgba(212,175,55,.12);color:#D4AF37}
.b4{background:rgba(255,140,80,.12);color:#FF9060}

/* ── CAPITAL RECOVERY MILESTONE ── */
.cap-rec-row{background:rgba(212,175,55,.05)!important;border-left:3px solid rgba(212,175,55,.45)!important}
.cap-badge{display:inline-flex;align-items:center;margin-left:7px;font-size:9px;font-weight:700;color:var(--gold);background:rgba(212,175,55,.13);border:1px solid rgba(212,175,55,.28);padding:2px 7px;border-radius:100px;vertical-align:middle;white-space:nowrap}
.cap-rec-val{color:var(--gold)!important;font-weight:700!important}

/* ── DIVIDER ── */
.div{height:1px;background:linear-gradient(90deg,transparent,var(--cbr),transparent);margin:40px 0}

/* ── FOOTER ── */
footer{position:relative;z-index:1;border-top:1px solid var(--cbr);padding:28px 20px;text-align:center}
.flogo-wrap{display:flex;align-items:center;justify-content:center;margin-bottom:14px}
.logo-img-footer{height:24px;width:auto;max-width:160px;object-fit:contain;opacity:.7}
.disc{max-width:660px;margin:0 auto;font-size:11px;color:rgba(240,240,240,.3);line-height:1.7}
.disc strong{color:rgba(240,240,240,.44)}

/* ── TOAST ── */
.toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%) translateY(80px);background:rgba(37,211,102,.12);border:1px solid rgba(37,211,102,.28);backdrop-filter:var(--blur);color:#25D366;padding:10px 22px;border-radius:100px;font-size:13px;font-weight:600;z-index:1000;transition:transform .4s cubic-bezier(.34,1.56,.64,1);white-space:nowrap}
.toast.show{transform:translateX(-50%) translateY(0)}

/* ══ RESPONSIVE ══════════════════════════════════════════ */
/* Tablet landscape: 1024px */
@media(max-width:1024px){
  .pgrid{grid-template-columns:repeat(2,1fr)}
  .rgrid{grid-template-columns:repeat(3,1fr)}
}
/* Tablet portrait: 768px */
@media(max-width:768px){
  main{padding:28px 16px 70px}
  .hero{padding:36px 0 18px}
  .card{padding:18px}
  .cgrid{grid-template-columns:1fr}
  .wgrid{grid-template-columns:1fr}
  .rgrid{grid-template-columns:repeat(3,1fr)}
  .rval{font-size:clamp(13px,3.2vw,17px)}
  nav a{font-size:11px;padding:5px 10px}
  .pstat{font-size:11.5px}
}
/* Large phone: 600px */
@media(max-width:600px){
  .hdr{height:52px;gap:8px}
  .logo-img{height:26px;max-width:140px}
  .pgrid{grid-template-columns:repeat(2,1fr)}
  .rgrid{grid-template-columns:repeat(2,1fr)}
  .rval{font-size:clamp(12px,4vw,16px)}
  .ri{padding:12px 9px}
  .rlabel{font-size:8.5px}
  .rsub{font-size:8px;line-height:1.4}
  th{padding:8px 9px;font-size:8.5px;letter-spacing:.4px}
  td{padding:8px 9px;font-size:11px}
  .cap-badge{font-size:8px;padding:2px 5px;margin-left:4px}
  .hero h1{font-size:clamp(24px,7vw,36px)}
  section{margin-bottom:38px}
  .sh h2{font-size:clamp(15px,4vw,20px)}
}
/* Small phone: 420px */
@media(max-width:420px){
  main{padding:16px 12px 60px}
  .hero{padding:28px 0 14px}
  .hero h1{font-size:clamp(22px,8.5vw,30px)}
  .hero p{font-size:12px}
  .card{padding:14px;border-radius:16px}
  .pgrid{grid-template-columns:repeat(2,1fr);gap:10px}
  .pcard{padding:12px}
  .pa{font-size:17px}
  .pp{font-size:9.5px}
  .pstat{font-size:11px}
  .pdur{font-size:9px;padding:2px 7px}
  .rgrid{grid-template-columns:repeat(2,1fr);gap:8px}
  .ri{padding:11px 8px}
  .rval{font-size:12px}
  .rlabel{font-size:8px}
  .rsub{font-size:7.5px}
  .bcalc{font-size:13px;padding:13px}
  input[type=number],input[type=date]{font-size:15px;padding:13px 13px 13px 34px}
  nav a{font-size:10px;padding:4px 8px}
  .tbox{max-height:340px}
  .sh{gap:7px}
  .badge{font-size:9px;padding:3px 8px}
  .htag{font-size:10px;padding:5px 14px}
  .chip{font-size:10px;padding:4px 10px}
  section{margin-bottom:32px}
}
/* Tiny phone: 360px */
@media(max-width:360px){
  .logo-img{height:22px;max-width:110px}
  .pgrid{gap:8px}
  .rgrid{grid-template-columns:repeat(2,1fr);gap:6px}
  .ri{padding:10px 7px}
  .rval{font-size:11.5px}
  .hero h1{font-size:clamp(20px,9vw,28px)}
  .pstat{font-size:10.5px}
  th{padding:7px 8px;font-size:8px}
  td{padding:7px 8px;font-size:10.5px}
}
</style>
</head>
<body>
<div class="gp"></div><div class="gg"></div>

<header>
  <div class="hdr">
    <a class="logo-wrap" href="#">
      <img src="data:image/png;base64," class="logo-img" alt="Minttora">
    </a>
    <nav>
      <a href="#presets">Ejemplos</a>
      <a href="#calc-sec">Calculadora</a>
      <a href="#withdrawal">Retiro</a>
      <a href="#projection">Proyección</a>
      <a href="#comparison">Paquetes</a>
    </nav>
  </div>
</header>

<main>

<!-- ── HERO ── -->
<section class="hero">
  <div class="htag">Inversión en Oro Tokenizado</div>
  <h1>Calcula tu<br><span class="g">retorno dorado</span></h1>
  <p>Simula tu inversión en Minttora hasta alcanzar el <strong style="color:var(--gold)">300% de retorno</strong> sobre tu capital original.</p>
  <div class="chips" style="justify-content:center">
    <span class="chip"><span class="dot" style="background:var(--gold)"></span>Objetivo: 300% de retorno</span>
    <span class="chip"><span class="dot" style="background:var(--pur-l)"></span>Hasta 0.75% diario</span>
    <span class="chip"><span class="dot" style="background:#25D366"></span>19–24 meses estimados</span>
  </div>
</section>

<!-- ── PRESETS ── -->
<section id="presets">
  <div class="sh"><h2>Ejemplos Rápidos</h2><span class="badge">Clic para calcular</span></div>
  <div class="pgrid" id="pgrid"></div>
</section>

<!-- ── CALCULATOR ── -->
<section id="calc-sec">
  <div class="sh"><h2>Calculadora Principal</h2><span class="badge">Principal</span></div>
  <div class="card">
    <div class="cgrid">
      <div>
        <div class="ig">
          <label>Monto a Invertir (USD)</label>
          <div class="iw">
            <span class="ipfx">$</span>
            <input type="number" id="inv" placeholder="Ej. 1,000" min="30" step="1">
          </div>
        </div>
        <div class="pkgind" id="pkgind">
          <span class="pkgdot"></span>
          <span>Ingresa un monto para detectar el paquete</span>
        </div>
        <div class="infobox" style="margin-top:10px">
          Tu balance inicia en <strong>$0</strong>. Cada día hábil (lun–vie) se acumula la ganancia diaria. Primero <strong>recuperas tu capital</strong> (~6–9 meses) y luego todo es ganancia pura, hasta llegar al <strong>300% del monto original</strong>.
        </div>
      </div>
      <div style="display:flex;flex-direction:column;justify-content:flex-end;gap:10px">
        <div class="chips">
          <span class="chip"><span class="dot" style="background:var(--pur-l)"></span>Fee depósito: 1%</span>
          <span class="chip"><span class="dot" style="background:#ff7070"></span>Fee retiro: 3%</span>
          <span class="chip"><span class="dot" style="background:var(--gold)"></span>Meta: 300% sobre capital</span>
        </div>
        <button class="bcalc" onclick="doCalc()">Calcular Rendimiento →</button>
      </div>
    </div>

    <div id="results">
      <div class="rdiv"></div>
      <div class="rhdr">
        <div class="rtitle">Proyección de Rendimientos</div>
        <button class="bshare" onclick="doShare()">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 002 2h12a2 2 0 002-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
          Copiar para WhatsApp
        </button>
      </div>
      <div class="rgrid" id="rgrid"></div>
    </div>
  </div>
</section>

<div class="div"></div>

